# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.env

# 运行时数据（勿提交）
logs/
snapshots/
data/
!snapshots/.gitkeep
!logs/.gitkeep
!data/.gitkeep

# 本地/测试
*.log
.events.lock
/tmp/
mosaic_sample.mp4
*_sample.mp4

# 桌面端自带播放器，体积大，不进仓库
desktop/player/*
!desktop/player/.gitkeep
# 本机三台地址和打包中间目录，留在这台电脑
desktop/nodes.json
desktop/_pyi_work/
dist_desktop/

# 可选大模型（仓库只保留 README）
models/*.onnx
models/*.pt
models/*.pth
models/*.bin

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# 测试临时配置
/tmp/
